includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - resources/views/components

    # Level 10 is the highest level
    level: 8

    excludePaths:
        - _ide_helper.php
        - app/Models/Team
        - **/*.test.php
        - **/*.blade.php

    ignoreErrors:
        # Ignore common Blade component patterns that PHPStan doesn't understand
        - '#Expression "new class extends \\Livewire\\Component…" on a separate line does not do anything#'
        - '#Access to an undefined property Livewire\\Component@anonymous.*#'
